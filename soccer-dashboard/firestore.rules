rules_version = '2';

// Google アカウントでログインした人は、自分の領域（users/<自分の uid>/）だけを読み書きできる。
// 他の利用者の領域、決められた場所以外、未ログイン、Google 以外のログインはすべて拒否。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    // 1 件あたりのシートの大きさの上限（Firestore の 1 文書の上限 1MiB 未満）
    function sheetWithinLimit() {
      return request.resource.data.aoa is string && request.resource.data.aoa.size() < 950000;
    }

    // 取り込んだデータ（現在のデータ）
    match /users/{uid}/datasets/{docId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && sheetWithinLimit();
    }
    // 保存した分析
    match /users/{uid}/analyses/{docId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && sheetWithinLimit();
    }
    // 表示設定
    match /users/{uid}/settings/{docId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['bg', 'accent', 'pattern', 'strength']);
    }
  }
}
